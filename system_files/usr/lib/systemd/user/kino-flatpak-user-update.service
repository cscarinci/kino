# Update user-scope flatpaks (anything installed with --user). Same
# wake-race guard as the system updater - see that unit for the story.
# busctl talks to the system bus by default, so the NM Metered property
# is readable from a user unit.
[Unit]
Description=Update kino user flatpaks

[Service]
Type=oneshot
ExecCondition=/bin/bash -c 'nm-online -q -t 120 && [[ "$(busctl get-property org.freedesktop.NetworkManager /org/freedesktop/NetworkManager org.freedesktop.NetworkManager Metered | cut -c 3-)" == @(2|4) ]]'
ExecStart=/usr/bin/flatpak update --user --noninteractive
