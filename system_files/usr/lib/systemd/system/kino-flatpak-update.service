# Update system flatpaks. The ExecCondition guards the wake-from-suspend
# race: a Persistent= timer fires at wake-up, before Wi-Fi re-associates,
# when NetworkManager still reports Metered=0 (unknown). Wait up to 2 min
# for connectivity, then require an unmetered (2) or guessed-unmetered (4)
# connection. Same logic as the rpm-ostreed-automatic drop-in.
[Unit]
Description=Update kino system flatpaks

[Service]
Type=oneshot
ExecCondition=/bin/bash -c 'nm-online -q -t 120 && [[ "$(busctl get-property org.freedesktop.NetworkManager /org/freedesktop/NetworkManager org.freedesktop.NetworkManager Metered | cut -c 3-)" == @(2|4) ]]'
ExecStart=/usr/bin/flatpak update --system --noninteractive
# GC after update: apps dropped from the list leave orphaned runtimes
# behind forever otherwise.
ExecStartPost=/usr/bin/flatpak uninstall --unused --noninteractive
